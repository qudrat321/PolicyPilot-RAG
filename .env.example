# ==============================================================================
# PolicyPilot RAG - Production Environment Configuration Template ($0/mo Free Tier)
# ==============================================================================

# 1. Google AI Studio API Key (Free tier - for Gemini 3.1 Flash-Lite & text-embedding-004)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 1.1 Groq API Key & High-Speed LLM Inference (0ms cold start, 500+ tokens/sec)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# 2. Qdrant Cloud Free Tier Cluster (1GB RAM / 4GB storage - $0 cost forever, no credit card)
# Create your free cluster at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=policy_documents

# 3. Application Limits & Thresholds
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=5
MAX_TABLE_ROWS=300
MAX_TABLE_SHEETS=10
SIMILARITY_THRESHOLD=0.58
TOP_K_CHUNKS=4
MAX_TOTAL_VECTORS=1500

# 4. Frontend Environment Variable (Optional: only needed if Frontend is hosted separately on Vercel / Cloudflare Pages)
# VITE_API_URL=https://your-backend-app.onrender.com

# 5. Supabase Authentication & PostgreSQL Database (100% Free Tier, No Credit Card)
# Sign up free at: https://supabase.com/
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
