# Google AI Studio API Key (Free tier - for Gemini embeddings & fallback generation)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key & Models (High-speed LPU inference, $0 free tier)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Qdrant Cloud Free Cluster (1GB RAM / 4GB storage - $0 cost)
# Create a free cluster at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=policy_documents

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=5
MAX_TABLE_ROWS=300
MAX_TABLE_SHEETS=10
SIMILARITY_THRESHOLD=0.58
TOP_K_CHUNKS=4
